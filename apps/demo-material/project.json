{
  "name": "demo-material",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/demo-material/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/demo-material",
        "browser": "apps/demo-material/src/main.ts",
        "tsConfig": "apps/demo-material/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/demo-material/public"
          }
        ],
        "styles": [
          "apps/demo-material/src/styles.css",
          "apps/demo-material/src/theme.scss"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "600kb",
              "maximumError": "1.3mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "local": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/demo-material/src/environments/environment.ts",
              "with": "apps/demo-material/src/environments/environment.local.ts"
            }
          ]
        },
        "pages": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "600kb",
              "maximumError": "1.3mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "baseHref": "/demo-material/",
          "fileReplacements": [
            {
              "replace": "apps/demo-material/src/environments/environment.ts",
              "with": "apps/demo-material/src/environments/environment.pages.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4200
      },
      "configurations": {
        "production": {
          "buildTarget": "demo-material:build:production"
        },
        "development": {
          "buildTarget": "demo-material:build:development"
        },
        "local": {
          "buildTarget": "demo-material:build:local"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "demo-material:build",
        "port": 4200,
        "staticFilePath": "dist/apps/demo-material/browser",
        "spa": true
      }
    }
  }
}
